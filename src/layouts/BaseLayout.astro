---
import { IS_LIVE, SITE_URL } from '../config/site';
import { businessFact } from '../content/query';
// The token layer (ADR 0004). Imported here rather than per page, because it is the one thing every
// page needs and the layout is the one file every page goes through. `tools/check-tokens.mjs`
// asserts this import exists — a token file nothing loads passes every other check and styles
// nothing.
import '../styles/tokens.css';

interface Props {
  /** Page title, without the site name — the layout appends that. */
  title: string;
  /** Meta description. Prose about the page, so it is passed in rather than read from the model. */
  description?: string;
}

const { title, description } = Astro.props;

// The canonical URL is built from the state's own origin, so a preview page never claims to be
// the live one (ADR 0006 §5 — the gate governs the canonical URL as well as the `noindex` tag).
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

// Read from the content model, never typed here (ADR 0003 §9).
const tradingName = await businessFact('trading-name');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      The indexing gate (ADR 0006 §4). `noindex` is the guarantee, and it is the *only* guarantee:
      `robots.txt` deliberately does not block crawling, because a blocked crawler never reads this
      tag and the URL can then be indexed by name anyway. Adding a `Disallow` is not a safety
      improvement — it defeats this. Removing this tag is a go-live gate, never a side effect.
    */}
    {!IS_LIVE && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Content Security Policy via a meta element (ADR 0009 §7). GitHub Pages serves static files and
      allows no custom response headers, so this is the only delivery mechanism available. It is
      defence in depth behind ADR 0009 §6's invariant — the site loads nothing from a third party —
      not a substitute for it.

      `frame-ancestors`, `report-uri` and `sandbox` are excluded from meta-delivered policies by the
      CSP specification, so clickjacking cannot be mitigated in this hosting model. ADR 0009 §7
      records that as an accepted residual risk rather than leaving a future session to hunt for a
      header setting that does not exist here.

      `style-src` allows inline styles because Astro emits scoped component styles that way; every
      other directive is `self` or `none`.
    */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-src 'none'"
    />

    {/*
      The trading name is read from its authority, never typed here. It was hard-coded in this line
      until 2026-07-19, which is exactly the defect the content model exists to prevent — and it was
      only noticed because ADR 0004 R5 changed the apostrophe and one of the two copies would have
      silently kept the old one. A duplicated fact does not announce itself; it waits.
    */}
    <title>{title} — {tradingName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
  </head>

  <body>
    <slot />
  </body>
</html>

<style>
  /*
    The site-wide defaults, and nothing more. Component styling belongs to the components; what is
    here is the handful of things that must be true on every page before any of them is written.
    Every value comes from `src/styles/tokens.css` (ADR 0004 §2) — `tools/check-tokens.mjs` rejects a
    raw one, so this file cannot quietly become a second palette.
  */
  :global(html) {
    /*
      `color-scheme` is not cosmetic here. A page that declares no colours inherits the browser's
      dark theme and renders dark-on-dark, which is what the first browser check of this scaffold
      actually showed. The palette below is a light one, so the browser is told so explicitly rather
      than left to infer it from a background it may not have painted yet.
    */
    color-scheme: light;

    /*
      The gradient is the page itself, not a band at the top of it (ADR 0004 §2). `fixed` keeps it
      one continuous surface down a long page instead of restarting the ramp per screenful — and it
      is what makes the five stops the contrast check measures against the *actual* backgrounds.
    */
    background: var(--page-background) fixed;
    color: var(--colour-text);
    font-family: var(--font-body);
    font-weight: var(--weight-body);
    line-height: var(--leading-body);

    /*
      Deliberately no `font-size` here. Setting one would re-anchor every `rem` on the site and
      silently discard the text size a reader chose in their own browser — the mitigation ADR 0004 R2
      relies on, given that body copy is 15px at weight 300. The size goes on `body`, where it styles
      text without moving the unit. Asserted by `tools/check-tokens.mjs`.
    */
  }

  :global(body) {
    margin: 0;
    padding: var(--space-7) var(--gutter);
    font-size: var(--text-base);
    min-height: 100vh;
  }

  :global(h1),
  :global(h2),
  :global(h3) {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    line-height: var(--leading-tight);
    color: var(--colour-brand);
    /* Headings use the fluid top steps of the scale, so a long one reflows rather than running to
       the edge — the old site's hero title kept its size whatever its length. */
    text-wrap: balance;
  }

  :global(a) {
    color: var(--colour-brand);
  }
</style>
