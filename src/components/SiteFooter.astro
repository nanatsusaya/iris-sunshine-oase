---
/**
 * The site footer (ADR 0004, draft turn 6).
 *
 * Same rule as the header: **no link to a page that does not exist yet.** The draft's footer carries
 * four columns of them — Solarium, Naturkosmetik, Über uns, Preise, Impressum, Datenschutz — and none
 * of those pages have been built. What remains is what is real: the studio's own details, which have
 * an authority in `src/content/business.yaml`, and the homepage's own sections.
 *
 * **The missing Impressum is a go-live gate, not an oversight.** § 5 TMG requires a German commercial
 * website to carry one, and this preview does not — it is `noindex`, unlinked and not the studio's
 * live site, which is still served from netcup (ADR 0006). The obligation attaches at cutover, and
 * `docs/STATUS.md` records it there rather than leaving it to be noticed on the day.
 *
 * No copyright year. A year rendered at build time is correct on the day it is built and silently
 * wrong from every January onwards, and nothing in German law makes the notice necessary. A fact that
 * goes stale on its own is the class of defect this repository exists to remove — so it is not created.
 */
import { telHref } from '../content/format';
import { businessFact } from '../content/query';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';

const [tradingName, street, postcodeTown, telephone, email] = await Promise.all([
  businessFact('trading-name'),
  businessFact('street'),
  businessFact('postcode-town'),
  businessFact('telephone'),
  businessFact('email'),
]);
---

<footer class="footer">
  <div class="inner">
    <div class="brand">
      <Wordmark size="quiet" />
      <p class="tagline">Kosmetik- &amp; Sonnenstudio in Herxheim bei Landau (Pfalz).</p>
    </div>

    <div class="block">
      <h2 class="title">Adresse</h2>
      {/*
        The postal address is one object, so it is one `<address>` with line breaks rather than a list
        — and every line of it comes from the content model. The studio's own details are publishable
        by law (§ 5 TMG); nothing here belongs to a third party.
      */}
      <address class="address">
        {tradingName}<br />
        {street}<br />
        {postcodeTown}
      </address>
    </div>

    <div class="block">
      <h2 class="title">Kontakt</h2>
      <a class="line" href={telHref(telephone)}>
        <Icon name="phone" />
        {telephone}
      </a>
      <a class="line" href={`mailto:${email}`}>
        <Icon name="mail" />
        {email}
      </a>
    </div>
  </div>

  <p class="note">Alle Preise ohne Gewähr.</p>
</footer>

<style>
  .footer {
    background: var(--surface-card-strong);
    border-top: 1px solid var(--surface-card-border);
    padding: var(--space-7) var(--gutter) var(--space-5);
    backdrop-filter: blur(12px);
    font-size: var(--text-sm);
  }

  .inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    /* Mobile-first: one column. `M-09` — the old site's two-column layout that never wrapped — is
       what the unprefixed case being the small-screen case prevents (ADR 0004 §7). */
    gap: var(--space-6);
  }

  .tagline {
    margin: var(--space-3) 0 0;
    color: var(--colour-text-muted);
    max-width: var(--measure);
  }

  .title {
    /* A heading by role, not by size: it labels a block for a screen reader walking the page, and it
       is set as a small label because that is what the draft draws. */
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colour-brand);
    margin: 0 0 var(--space-3);
  }

  .address {
    font-style: normal;
    line-height: var(--leading-body);
  }

  .line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--colour-text);
    text-decoration: none;
    /* A telephone number or an address is a tap target as much as a link; the draft's own rows sit at
       roughly this rhythm. */
    padding: var(--space-1) 0;
    /* Long e-mail addresses must not force the page to scroll sideways at 320px. */
    overflow-wrap: anywhere;
  }

  .line:hover,
  .line:focus-visible {
    color: var(--colour-brand);
    text-decoration: underline;
  }

  .note {
    max-width: var(--container);
    margin: var(--space-6) auto 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-rule);
    color: var(--colour-text-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 48rem) {
    .footer {
      padding: var(--space-7) var(--space-6) var(--space-5);
    }

    .inner {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: var(--space-7);
    }
  }
</style>
