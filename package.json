    "check:external": "node tools/check-external-resources.mjs",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.4",
    "typescript": "~5.9.3"
  }
}
